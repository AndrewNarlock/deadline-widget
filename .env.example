# Copy this file to .env and fill it in. .env is gitignored: the feed URL is a secret.

# Canvas > Calendar > Calendar Feed (bottom right). Paste the whole link.
CANVAS_FEED_URL=

# Optional: course web pages with readings, separated by commas.
COURSE_PAGES=

# Dates Claude reads from text must fall inside the term.
TERM_START=2026-09-30
TERM_END=2026-12-18

# Optional settings
CLAUDE_MODEL=haiku
DAYS_AHEAD=30
# Study minutes per day that today's plan may fill.
DAILY_MINUTES=180
